#!/bin/bash
set -euo pipefail

# -------------------------
# Color Definitions
# -------------------------
RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
BLUE='\e[34m'
CYAN='\e[36m'
RESET='\e[0m'

# -------------------------
# Animate Logo
# -------------------------
animate_logo() {
  clear
  local logo=(
    "██╗░░░██╗██████╗░░██████╗"
    "██║░░░██║██╔══██╗██╔════╝"
    "╚██╗░██╔╝██████╔╝╚█████╗░"
    "░╚████╔╝░██╔═══╝░░╚═══██╗"
    "░░╚██╔╝░░██║░░░░░██████╔╝"
    "░░░╚═╝░░░╚═╝░░░░░╚═════╝░"
    ""
    "        ZynoxPlayzYT VPS"
  )

  for line in "${logo[@]}"; do
    echo -e "${YELLOW}${line}${RESET}"
    sleep 0.15
  done
  echo ""
  sleep 0.3
}

# -------------------------
# Show Animated Logo
# -------------------------
animate_logo

# -------------------------
# Local System Info (safe)
# -------------------------
echo -e "${CYAN}Gathering local system info...${RESET}"
# safe, read-only checks
CPU_CORES=$(nproc 2>/dev/null || echo "unknown")
TOTAL_MEM=$(awk '/MemTotal/ {print $2 " kB"}' /proc/meminfo 2>/dev/null || echo "unknown")
KERNEL=$(uname -sr)
echo -e "${GREEN}CPU cores: ${RESET}${CPU_CORES}"
echo -e "${GREEN}Total memory: ${RESET}${TOTAL_MEM}"
echo -e "${GREEN}Kernel: ${RESET}${KERNEL}"
echo ""

# -------------------------
# Menu Display
# -------------------------
echo -e "${YELLOW}Select an option:${RESET}"
echo -e "${GREEN}1) Run a local script (safe)${RESET}"
echo -e "${BLUE}2) Show instructions to add your trusted GitHub raw URL${RESET}"
echo -e "${RED}3) Exit${RESET}"
echo -ne "${YELLOW}Enter your choice (1-3): ${RESET}"
read -r choice

case $choice in
  1)
    echo -e "${GREEN}Enter path to a local script to run (example: ./install.sh)${RESET}"
    read -r local_path
    if [[ -f "$local_path" && -x "$local_path" ]]; then
      echo -e "${CYAN}Running local script: $local_path${RESET}"
      "$local_path"
    elif [[ -f "$local_path" ]]; then
      echo -e "${YELLOW}File exists but not executable. Making it executable and running...${RESET}"
      chmod +x "$local_path"
      "$local_path"
    else
      echo -e "${RED}File not found: $local_path${RESET}"
      exit 1
    fi
    ;;
  2)
    cat <<'INSTR'
--- How to add your trusted GitHub raw script (SAFE instructions) ---

1) Upload your script file to your GitHub repo (example: script name ZynoxVPS).
   - Make sure it's a public repo (or you have raw access).
   - Example raw URL format:
     https://raw.githubusercontent.com/USERNAME/REPO/BRANCH/FILENAME

2) BEFORE you run any remote script, review it manually in browser (Open the raw URL and inspect).
   Do NOT run scripts you don't trust.

3) If you trust the script, run it manually like:
   curl -fsSL "https://raw.githubusercontent.com/USERNAME/REPO/BRANCH/FILENAME" -o /tmp/my_script.sh
   less /tmp/my_script.sh    # inspect content
   chmod +x /tmp/my_script.sh
   /tmp/my_script.sh

(This script intentionally does NOT perform curl|bash to avoid accidental remote execution.)

INSTR
    ;;
  3)
    echo -e "${RED}Exiting...${RESET}"
    exit 0
    ;;
  *)
    echo -e "${RED}Invalid choice! Please select 1, 2, or 3.${RESET}"
    exit 1
    ;;
esac

echo -e "${YELLOW}Made by ZynoxPlayzYT ✨${RESET}"
    exit 1
    ;;
esac

echo -e "${YELLOW}Made by ZynoxPlayzYT ✨${RESET}"
