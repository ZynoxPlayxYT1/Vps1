#!/usr/bin/env bash
# -------------------------------------------------------------
#  Secure Auto-Auth Runner
#  - Decodes Base64 creds
#  - Writes ~/.netrc safely
#  - Authenticates & fetches remote script
#  - Executes with full safety guards
#  Author: ZynoxPlayzYT
# -------------------------------------------------------------
set -euo pipefail

# ------------------ CONFIG ------------------
URL="https://airlink-menu.jishnumondal32.workers.dev"
HOST="airlink-menu.jishnumondal32.workers.dev"
NETRC="${HOME}/.netrc"

# ------------------ HELPERS ------------------
b64d() { printf '%s' "$1" | base64 -d; }

# ------------------ CREDENTIALS ------------------
USER_B64="amlzaG51"
PASS_B64="amlzaG51aEBja2VyMTIz"

USER_RAW="$(b64d "$USER_B64")"
PASS_RAW="$(b64d "$PASS_B64")"

if [[ -z "$USER_RAW" || -z "$PASS_RAW" ]]; then
  echo "[!] Credential decode failed." >&2
  exit 1
fi

# ------------------ REQUIREMENTS ------------------
if ! command -v curl >/dev/null 2>&1; then
  echo "[!] curl is required but missing." >&2
  exit 1
fi

# ------------------ NETRC SETUP ------------------
printf "[i] Preparing .netrc ...\n"
touch "$NETRC"
chmod 600 "$NETRC"

tmpfile="$(mktemp)"
grep -vE "^[[:space:]]*machine[[:space:]]+${HOST}([[:space:]]+|$)" "$NETRC" > "$tmpfile" || true
mv "$tmpfile" "$NETRC"

{
  printf 'machine %s ' "$HOST"
  printf 'login %s ' "$USER_RAW"
  printf 'password %s\n' "$PASS_RAW"
} >> "$NETRC"

# ------------------ FETCH & EXECUTE ------------------
printf "[i] Downloading secure script...\n"

script_file="$(mktemp)"
trap 'rm -f "$script_file"' EXIT

if curl -fsS --netrc -o "$script_file" "$URL"; then
  printf "[✓] Auth OK. Running script...\n"
  bash "$script_file"
else
  echo "[✗] Authentication or download failed." >&2
  exit 1
fi

printf "[✓] Finished.\n"
